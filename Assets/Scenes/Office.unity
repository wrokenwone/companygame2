--- !u!114 &1808743402
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1808743398}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 025b5abfd6948d046a4a8b5aac6e7179, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteract
  npcName: Ahmet
  npcPortrait: {fileID: 7574722205383545943, guid: 53adf6dca52f93b40bbbc210abe1a214, type: 3}
  ePrompt: {fileID: 1215355279}
  tasks:
  - taskName: Coffe
    minigameType: 2
    introDialogue:
    - isPlayer: 0
      dialogueText: Yeni misin?
    - isPlayer: 1
      dialogueText: Evet
    - isPlayer: 0
      dialogueText: "Ka\xE7 g\xFCnd\xFCr burdas\u0131n?"
    - isPlayer: 1
      dialogueText: "Bug\xFCn ilk g\xFCn."
    - isPlayer: 0
      dialogueText: "Ben de \xF6yle demi\u015Ftim."
    - isPlayer: 0
      dialogueText: "3 y\u0131l \xF6nce.."
    - isPlayer: 0
      dialogueText: Neyse kahve doldurur musun?
    - isPlayer: 0
      dialogueText: "Ne eksik ne fazla. Tam olmal\u0131!"
    rejectDialogue:
    - isPlayer: 0
      dialogueText: "Tam i\u015Fte."
    - isPlayer: 1
      dialogueText: "Bu \xE7ok belirsiz."
    - isPlayer: 0
      dialogueText: "Burada her \u015Fey belirsiz."
    successDialogue:
    - isPlayer: 0
      dialogueText: ...
    - isPlayer: 0
      dialogueText: Evet.
    - isPlayer: 1
      dialogueText: "Be\u011Fendin mi?"
    - isPlayer: 0
      dialogueText: Kahveyi mi?
    - isPlayer: 1
      dialogueText: Evet.
    - isPlayer: 0
      dialogueText: "\u0130\xE7medim ki."
    - isPlayer: 0
      dialogueText: "Ama g\xF6rsel olarak tatmin edici"
    - isPlayer: 1
      dialogueText: "Te\u015Fekk\xFCr ederim."
    - isPlayer: 1
      dialogueText: Rica etmem.
    failDialogue:
    - isPlayer: 1
      dialogueText: Ah pardon-
    - isPlayer: 0
      dialogueText: "B\xF6yle iyi. Hat\u0131ra olsun"
    - isPlayer: 1
      dialogueText: "Ne hat\u0131ras\u0131?"
    - isPlayer: 0
      dialogueText: "\u0130lk ve son kahven."
    acceptButtonText: Tamam.
    rejectButtonText: Tam derken.. ne kadar tam?
  - taskName: Form
    minigameType: 1
    introDialogue:
    - isPlayer: 0
      dialogueText: "\u015Eu formu doldurur musun? Standart prosed\xFCr."
    rejectDialogue:
    - isPlayer: 0
      dialogueText: "Standart prosed\xFCr."
    - isPlayer: 1
      dialogueText: Ama-
    - isPlayer: 0
      dialogueText: "Standart prosed\xFCr."
    successDialogue:
    - isPlayer: 0
      dialogueText: Hmm.
    - isPlayer: 1
      dialogueText: "Do\u011Fru mu?"
    - isPlayer: 0
      dialogueText: Bilmiyorum.
    - isPlayer: 1
      dialogueText: Ne?
    - isPlayer: 0
      dialogueText: "Do\u011Fru cevap yok ki."
    - isPlayer: 1
      dialogueText: O zaman nede-
    - isPlayer: 0
      dialogueText: "Nas\u0131l cevaplad\u0131\u011F\u0131n \xF6nemli."
    - isPlayer: 0
      dialogueText: "Sen teredd\xFCt etmedin."
    - isPlayer: 0
      dialogueText: "Bu onlar i\xE7in yeterli."
    failDialogue:
    - isPlayer: 0
      dialogueText: Ah.
    - isPlayer: 1
      dialogueText: "Yanl\u0131\u015F m\u0131?"
    - isPlayer: 0
      dialogueText: Evet.
    - isPlayer: 1
      dialogueText: "Ne hissettiysem onu i\u015Faretledim."
    - isPlayer: 0
      dialogueText: "Bi severance olamad\u0131k."
    acceptButtonText: Tabii.
    rejectButtonText: "Bu sorular \xE7ok ki\u015Fisel d\u011Feil mi?"
  trustIntroDialogue:
  - isPlayer: 0
    dialogueText: "Bir dakikan var m\u0131?"
  - isPlayer: 0
    dialogueText: "Yani... zorunda de\u011Filsin."
  trustOption1Text: So?uk Davran
  option1GainsTrust: 0
  trustOption1Dialogue:
  - isPlayer: 1
    dialogueText: "\u015Eu an me\u015Fgul\xFCm."
  - isPlayer: 0
    dialogueText: Tabii.
  - isPlayer: 0
    dialogueText: "Hep me\u015Fgul\xFCz."
  - isPlayer: 0
    dialogueText: "\xD6z\xFCr dilerim sordu\u011Fum i\xE7in."
  trustOption2Text: Yak?n Davran
  option2GainsTrust: 1
  trustOption2Dialogue:
  - isPlayer: 1
    dialogueText: Var, ne oldu?
  - isPlayer: 0
    dialogueText: "Hi\xE7.."
  - isPlayer: 0
    dialogueText: "Hi\xE7 farkl\u0131 bir \u015Fey yapmak istedin mi?"
  - isPlayer: 1
    dialogueText: Ne gibi?
  - isPlayer: 0
    dialogueText: Bilmiyorum.
  - isPlayer: 0
    dialogueText: "Ben de bilseydim burada olmazd\u0131m."
  - isPlayer: 1
    dialogueText: ....
  - isPlayer: 0
    dialogueText: "Neyse. Te\u015Fekk\xFCrler."
  - isPlayer: 1
    dialogueText: "Ne i\xE7in?"
  - isPlayer: 1
    dialogueText: "Durdu\u011Fun i\xE7in :)"
