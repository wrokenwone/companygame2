  introDialogue:
  - isPlayer: 0
    dialogueText: ...
  - isPlayer: 1
    dialogueText: Merhaba?
  - isPlayer: 0
    dialogueText: "(Ka\u011F\u0131t sesleri)"
  - isPlayer: 0
    dialogueText: ??
  - isPlayer: 0
    dialogueText: "\u015Eakayd\u0131. "
  - isPlayer: 0
    dialogueText: Gidebilirsin
  - isPlayer: 1
    dialogueText: "\xC7al\u0131\u015Ft\u0131rmam la\u0131zm seni"
  - isPlayer: 1
    dialogueText: "Hay\u0131r."
  option1Text: "L\xFCtfen, i\u015Fim var."
  option2Text: "Nas\u0131ls\u0131n?"
  failChoiceDialogue:
  - isPlayer: 0
    dialogueText: "Herkesin i\u015Fi var."
  - isPlayer: 0
    dialogueText: Bu beni ilgilendirmiyor
  - isPlayer: 1
    dialogueText: Ama-
  - isPlayer: 0
    dialogueText: Gidebilirsin.
  option2Dialogue:
  - isPlayer: 0
    dialogueText: ...
  - isPlayer: 0
    dialogueText: "Bu soruyu sormad\u0131n."
  - isPlayer: 1
    dialogueText: Sordum?
  - isPlayer: 0
    dialogueText: "Ger\xE7ekten mi soruyorsun?"
  - isPlayer: 1
    dialogueText: Evet.
  - isPlayer: 0
    dialogueText: ....
  - isPlayer: 0
    dialogueText: Yoruldum.
  option3Text: Dinliyorum.
  option3Dialogue:
  - isPlayer: 0
    dialogueText: "3 y\u0131ld\u0131r buraday\u0131m."
  - isPlayer: 0
    dialogueText: "Kimse ad\u0131m\u0131 sormad\u0131."
  - isPlayer: 1
    dialogueText: "Ad\u0131n ne?"
  - isPlayer: 0
    dialogueText: ...
  - isPlayer: 0
    dialogueText: Bilmiyorum
  - isPlayer: 0
    dialogueText: "Bana hi\xE7 ad vermediler"
  - isPlayer: 1
    dialogueText: ...
  option4Text: Hadi sana bir ad verelim
  option4Dialogue:
  - isPlayer: 0
    dialogueText: ..
  - isPlayer: 0
    dialogueText: Ne?
  - isPlayer: 1
    dialogueText: Evet.
  - isPlayer: 1
    dialogueText: Senin ismin...
  - isPlayer: 1
    dialogueText: BULDUM!
  - isPlayer: 1
    dialogueText: "Yaz\u0131c\u0131ya ne dersin?"
  - isPlayer: 0
    dialogueText: EVET!
  - isPlayer: 0
    dialogueText: "\u015Fimdi \xE7al\u0131\u015Fabilirim. WUHUU!"
  successOutcomeDialogue:
  - isPlayer: 0
    dialogueText: SUCESSSSS
  - isPlayer: 0
    dialogueText: 
