--- !u!114 &1442062249
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1442062245}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 025b5abfd6948d046a4a8b5aac6e7179, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteract
  npcName: Selin
  npcPortrait: {fileID: -7503768634995859389, guid: bba43394bd579c345a8b3f8b90ad52b3, type: 3}
  ePrompt: {fileID: 1857840527}
  tasks:
  - taskName: Photo
    minigameType: 0
    introDialogue:
    - isPlayer: 0
      dialogueText: Merhaba! Yeni misin?
    - isPlayer: 1
      dialogueText: Evet.
    - isPlayer: 0
      dialogueText: Harika!Ben de yeniyim.
    - isPlayer: 1
      dialogueText: "Ne zamand\u0131r buradas\u0131n?"
    - isPlayer: 0
      dialogueText: "2 y\u0131l. Neyse \u015Fu foto\u011Fraflara bak\u0131p \u015Firket
        ruhuna en uygun olan\u0131 se\xE7er misin?"
    rejectDialogue:
    - isPlayer: 0
      dialogueText: "Hay\u0131r."
    - isPlayer: 1
      dialogueText: Ama-
    - isPlayer: 0
      dialogueText: "Hay\u0131r."
    successDialogue:
    - isPlayer: 0
      dialogueText: Evet! Bu!
    - isPlayer: 1
      dialogueText: Neden bu?
    - isPlayer: 0
      dialogueText: Bilmiyorum.
    - isPlayer: 1
      dialogueText: Ben de bilmiyordum zaten.
    - isPlayer: 0
      dialogueText: "\u0130\u015Fte o y\xFCzden do\u011Fru."
    - isPlayer: 1
      dialogueText: "Bu mant\u0131kl\u0131 de\u011Fil."
    - isPlayer: 0
      dialogueText: "Burada \xE7al\u0131\u015F\u0131yorsun art\u0131k."
    - isPlayer: 0
      dialogueText: "Mant\u0131k opsiyonel ."
    failDialogue:
    - isPlayer: 0
      dialogueText: "Hay\u0131r."
    - isPlayer: 1
      dialogueText: Neden?
    - isPlayer: 0
      dialogueText: "Enerjisi yanl\u0131\u015F."
    - isPlayer: 1
      dialogueText: "Foto\u011Fraf\u0131n enerjisi mi?"
    - isPlayer: 0
      dialogueText: Evet.
    - isPlayer: 1
      dialogueText: "Hepsi ayn\u0131 foto\u011Fraf de\u011Fil miydi?"
    - isPlayer: 0
      dialogueText: "Kesinlikle hay\u0131r."
    - isPlayer: 0
      dialogueText: "K\xFC\xE7\xFCk piksel farkl\u0131l\u0131klar\u0131 vard\u0131"
    - isPlayer: 1
      dialogueText: ...
    - isPlayer: 0
      dialogueText: "O pikseller \xE7ok \u015Fey ifade ediyor O\u011Fuz."
    - isPlayer: 1
      dialogueText: ....
    acceptButtonText: "Tamam, bakay\u0131m."
    rejectButtonText: "Bunlar\u0131n hepsi ayn\u0131 de\u011Fil mi?"
  - taskName: Printer
    minigameType: 4
    introDialogue:
    - isPlayer: 0
      dialogueText: "Yaz\u0131c\u0131 yine bozuldu."
    - isPlayer: 0
      dialogueText: " Ona bir \u015Feyler s\xF6ylersen \xE7al\u0131\u015F\u0131yor
        bazen."
    rejectDialogue:
    - isPlayer: 0
      dialogueText: Evet?
    - isPlayer: 1
      dialogueText: "Yaz\u0131c\u0131?"
    - isPlayer: 0
      dialogueText: "Tamam vazge\xE7tim. "
    - isPlayer: 0
      dialogueText: "Bu i\u015Fi yapamayaca\u011F\u0131n\u0131 bilmeliydim."
    successDialogue:
    - isPlayer: 0
      dialogueText: "Herkesle b\xF6yle konu\u015Fmaz."
    - isPlayer: 1
      dialogueText: Oh.. Sadece dinledim.
    - isPlayer: 0
      dialogueText: 'Vaktin varken dinle. '
    - isPlayer: 0
      dialogueText: "Neyse te\u015Fekk\xFCrler."
    failDialogue:
    - isPlayer: 0
      dialogueText: "Bir yaz\u0131c\u0131yla konu\u015Fmak ne kadar zor olabilir
        ki?"
    - isPlayer: 1
      dialogueText: "Ne dedi\u011Finin fark\u0131nda m\u0131s\u0131n?"
    - isPlayer: 1
      dialogueText: "Nece konu\u015Ftu\u011Fundan bile emin de\u011Filim."
    - isPlayer: 0
      dialogueText: Sadece dinlemen yeterli olurdu.
    - isPlayer: 0
      dialogueText: "Neyse. Ba\u015Fka bir \u015Fey yoksa gidebilirsin."
    acceptButtonText: Tabii, gidiyorum.
    rejectButtonText: "Yaz\u0131c\u0131yla m\u0131 konu\u015Faca\u011F\u0131m?"
  trustIntroDialogue:
  - isPlayer: 0
    dialogueText: "Sana bir \u015Fey sorsam?"
  trustOption1Text: "\u015Eu an pek vaktim yok."
  option1GainsTrust: 0
  trustOption1Dialogue:
  - isPlayer: 0
    dialogueText: Burada mutlu musun?
  - isPlayer: 1
    dialogueText: Evet, gayet iyi.
  - isPlayer: 0
    dialogueText: "Vay. Ger\xE7ekten mi?"
  - isPlayer: 1
    dialogueText: Evet.
  - isPlayer: 0
    dialogueText: ...
  - isPlayer: 0
    dialogueText: Tamam.
  trustOption2Text: Dinliyorum.
  option2GainsTrust: 1
  trustOption2Dialogue:
  - isPlayer: 1
    dialogueText: Burada mutlu musun?
  - isPlayer: 1
    dialogueText: "Hen\xFCz anlamaya \xE7al\u0131\u015F\u0131yorum."
  - isPlayer: 0
    dialogueText: "Anlad\u0131n m\u0131?"
  - isPlayer: 1
    dialogueText: "Hay\u0131r."
  - isPlayer: 0
    dialogueText: " En az\u0131ndan sen de anlam\u0131yorsun."
  - isPlayer: 0
    dialogueText: Bu... iyi hissettiriyor.
