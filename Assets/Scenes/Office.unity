  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NPCInteract
  npcName: Ceyda
  npcPortrait: {fileID: 21300000, guid: 6123f30fb5a68ba4085c6baf1f082b5b, type: 3}
  ePrompt: {fileID: 135446459}
  tasks:
  - taskName: Meeting
    minigameType: 3
    introDialogue:
    - isPlayer: 0
      dialogueText: ...
    - isPlayer: 1
      dialogueText: Merhaba?
    - isPlayer: 0
      dialogueText: "Toplant\u0131 var."
    - isPlayer: 1
      dialogueText: Ne- ne zaman?
    - isPlayer: 0
      dialogueText: "\u015Eimdi."
    - isPlayer: 0
      dialogueText: "Haz\u0131r ol."
    - isPlayer: 0
      dialogueText: "Toplant\u0131da aktif g\xF6r\xFCnmen laz\u0131m. S\xF6yleyince
        ba\u015F\u0131n\u0131 salla."
    rejectDialogue:
    - isPlayer: 0
      dialogueText: ...
    - isPlayer: 0
      dialogueText: "\xC7\u0131k."
    successDialogue:
    - isPlayer: 0
      dialogueText: "\u0130yi i\u015F."
    - isPlayer: 1
      dialogueText: "Te\u015Fekk\xFCrler. Toplant\u0131 ne hakk\u0131ndayd\u0131?"
    - isPlayer: 0
      dialogueText: ...
    - isPlayer: 0
      dialogueText: Bilmiyorum.
    - isPlayer: 1
      dialogueText: Sen de mi bilmiyorsun?
    - isPlayer: 0
      dialogueText: Kimse bilmiyor.
    - isPlayer: 0
      dialogueText: "Ama kafa sallad\u0131n."
    - isPlayer: 0
      dialogueText: Bu yeterliydi.
    failDialogue:
    - isPlayer: 0
      dialogueText: hmm.
    - isPlayer: 1
      dialogueText: "\xD6z\xFCr dilerim, ka\xE7\u0131rd\u0131m"
    - isPlayer: 0
      dialogueText: 3 kez.
    - isPlayer: 1
      dialogueText: "2 kez asl\u0131nda."
    - isPlayer: 0
      dialogueText: "Toplant\u0131y\u0131 da b\xF6yle dikkatli mi dinledin?"
    - isPlayer: 1
      dialogueText: "Olmas\u0131 gereken bu de\u011Fil miydi?"
    - isPlayer: 0
      dialogueText: ....
    acceptButtonText: "Anlad\u0131m."
    rejectButtonText: "Neden ger\xE7ekten dinlemiyoruz ki?"
  trustIntroDialogue:
  - isPlayer: 0
    dialogueText: "D\u0131\u015Far\u0131s\u0131 nas\u0131l?"
  trustOption1Text: So?uk Davran
  option1GainsTrust: 0
  trustOption1Dialogue:
  - isPlayer: 1
    dialogueText: "\u0130yi, normal."
  - isPlayer: 0
    dialogueText: ...Tamam
  trustOption2Text: Yak?n Davran
  option2GainsTrust: 1
  trustOption2Dialogue:
  - isPlayer: 1
    dialogueText: Ne demek istiyorsun?
  - isPlayer: 0
    dialogueText: "D\u0131\u015Far\u0131 \xE7\u0131k\u0131yor musun"
  - isPlayer: 0
    dialogueText: "Ben \xE7\u0131km\u0131yorum"
  - isPlayer: 1
    dialogueText: Neden?
  - isPlayer: 0
    dialogueText: "Buraya gelmek o kadar zaman ald\u0131 ki..."
  - isPlayer: 0
    dialogueText: "Geri nas\u0131l d\xF6n\xFClece\u011Fini unuttum."
  - isPlayer: 1
    dialogueText: ...
  - isPlayer: 0
    dialogueText: ....
  - isPlayer: 0
    dialogueText: Sen unutma
